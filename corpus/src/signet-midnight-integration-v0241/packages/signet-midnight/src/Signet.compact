// =======================================================================================================
// Sig Network (Signet) shared Compact library enabling contracts on the Midnight blockchain to leverage
// the Signet Distributed MPC network to execute arbitrary transactions on foreign blockchains.
// =======================================================================================================
//
//  Terms:
//    - client contract(s): contracts on the Midnight blockchain that integrate with the Signet
//                          Distributed MPC network to execute arbitrary transactions on foreign
//                          blockchains.
//    - Signet singleton: a single contract on the Midnight blockchain through which clients notify
//                        the MPC of signature requests, and through which the MPC posts back
//                        signatures and signed attestations of foreign executions. Each post is
//                        emitted as a contract event (the execution outputs themselves travel off
//                        chain).
//
//  Usage:
//   // Import this module at the start of a contract (resolved through node_modules via COMPACT_PATH):
//   import "@sig-net/midnight/src/Signet";
//
//  Key types at a glance (each declaration below carries the full contract):
//  - SignBidirectionalEventV1: a client contract's structured request for a signature on a transaction.
//  - RequestId: 32-byte id derived by calculateRequestIdV1.
//  - SignBidirectionalEventMapV1: the RequestId -> SignBidirectionalEventV1 map a client contract
//    declares in its own ledger for the MPC to read requests from.
//  - SignetSigner: the contract interface client contracts call to notify the Signet singleton.
//  - SignBidirectionalEventNotification: the notification delivered through that call, versioned by
//    the version byte it carries.
//  - SignatureRespondedEventV1: the MPC's posted signature answering a request.
//  - RespondBidirectionalEventV1: the MPC's posted attestation of the signed transaction's outcome
//    (executed, failed or unviable).
//
//  The V1 suffix marks the wire and hash-domain artefacts of protocol version 1 (the structs the
//  ledger stores and the singleton emits, and the circuits that hash, verify or construct them).
//  Vocabulary shared across versions (RequestId, OutputKind, Signature, the enums, the transaction
//  parameter structs, which TxParamType tags) and the version-tagged notification carry no suffix.
//
// These key types are best understood within the sign bidirectional flow that they enable:
// 1. Client contract stores a SignBidirectionalEvent in a SignBidirectionalEventMap in its own ledger
//    (against the calculated RequestId) and requests a signature from the MPC via a cross contract call
//    against the SignetSigner interface. The Signet singleton emits the SignBidirectionalEventNotification
//    as a contract event.
// 2. MPC polls the Signet singleton contract's events for SignBidirectionalEventNotifications and
//    uses each one to look the declared SignBidirectionalEvent signature request up in the named
//    client's own ledger. It generates the signature and posts a SignatureRespondedEvent (the requested
//    signature) through the Signet singleton, which emits it as a contract event.
// 3. Client polls the Signet singleton contract's SignatureRespondedEvent events, identifying the response
//    associated with their request by RequestId. Clients validate the signature is correct by checking with
//    the requested signing key. Then it broadcasts the signed txn to the target chain.
// 4. MPC observes the txn's outcome in a final block on the target chain (executed, failed,
//    or unviable when another request's transaction took its nonce) and posts a
//    RespondBidirectionalEvent attestation through the Signet singleton, which emits it as a
//    contract event beside the request id.
//    The client polls its request's posts and takes the first one that verifies over the request id,
//    block height, output kind and output. The client obtains the execution output off chain (for EVM: the mined
//    call's return data via debug_traceTransaction, re-serialised exactly as the MPC did with
//    executedEvmRespondOutput, or the exact attested bytes from the MPC's output cache) and hands the
//    serialised output plus attestation to its verify circuit. See
//    "Output Recovery and Serialisation" in the repository README.
//
// Read more:
//   - The sign bidirectional flow and key derivation: the repository README
//     ("Sign Bidirectional Protocol Flow", "Derived Keys").
//   - For full integration examples (such as an ERC20 cross chain vault example) see
//     the Midnight Examples repository at: https://github.com/sig-net/midnight-examples.
//   - Compact language reference (modules, types):
//     https://docs.midnight.network/compact/reference/compact-reference

module Signet {
  import CompactStandardLibrary;

  // Hash-domain indices are protocol u8 values. Append variants only.
  export enum HashDomain {
    requestId,
    attestationDigest,
    evmType2TxHeader,
    evmType2TxWord,
    evmType2TxAccessEntry,
    evmType2TxStorageKey,
  }

  // ---- SignBidirectionalEvent ------------------------------------------------------------------------

  // Structured request for a signature on a transaction. Generically configured by client contracts
  // based on the type of transaction for which a signature is requested (EVM Type 2, Solana etc.).
  //
  // KEY: texual order of the fields in this structure must remain fixed as is as their order
  //      is relied upon for consistent hashing and decoding from ledger state.
  export struct SignBidirectionalEventV1<TxParams, #LenOutputDeserialization, #LenRespondSerialization> {
    // ---- RequestIdPreimageV1 fields: hashed into the request id, in this order ----

    // MPC Key Derivation Parameters.
    // Every key the MPC signs with is scoped by the requesting contract:
    //   derivedSigningKey = f(mpcRootKey[keyVersion], caip2ChainId, sender, hex::encode(path))
    // where caip2ChainId is the CAIP-2 id of the ORIGINATING chain (the Midnight
    // variant for requests made from Midnight contracts), not this record's target
    // executionDest. The path is 32 opaque bytes of the client contract's choosing (e.g. a
    // fixed literal for a contract-owned account or a hash of a caller's secret for
    // per-user accounts): no format is enforced, and any 32 bytes are valid except
    // pad(32, "midnight response key"), which is reserved for the MPC response key and refused.
    // CRITICAL: the MPC renders the path as hex::encode(path) for key derivation (lowercase hex
    // of the full 32 bytes, no trimming, no 0x prefix). The sender is always part
    // of the derivation, so no contract can reach another contract's derived keys.
    keyVersion: Uint<8>;        // MPC root-key version to derive from. Currently 1.
    sender: ContractAddress;    // Address of the client contract that stores and notifies of this
                                // request. Set with kernel.self().
    path: Bytes<32>;            // Key derivation path: 32 opaque bytes, client contract's choice.

    // MPC Parameters.
    algo: MPCSignatureAlgorithm;    // Signature algorithm scheme, e.g. ecdsa

    // Target chain transaction parameters.
    txParamType: TxParamType;  // Off-chain tag indicating what type txParams is set to.
    txParams: TxParams;        // The generic transaction-param payload
    executionDest: Bytes<32>;  // The MPC's routing key for the target chain, in CAIP-2 form
                               // (https://chainagnostic.org/CAIPs/caip-2). An Ethereum target
                               // (mainnet, Sepolia or a local anvil) uses ethereumCaip2Id():
                               // the network itself is txParams' chainId.

    // ---- Protocol-only fields: outside the request id ----

    signatureDest: MPCDestination;  // Destination field reserved for future use. Set to unused.
    params: Bytes<64>;              // Extra MPC parameters reserved for future use. Zero-fill.

    // ---- Serialisation Schemas ----
    
    // outputDeserializationSchema tells the MPC how to decode the target chain's
    // execution output (target chain -> MPC).
    // The value is execution chain specific and sized per client contract: 
    // - Ethereum: an ABI JSON schema string (see https://docs.soliditylang.org/en/v0.8.30/abi-spec.html#json)
    //   in canonical form: `[{"name":"<identifier>","type":"<abi type>"},...]` with no
    //   whitespace, NUL-padded to LenOutputDeserialization (see the README's "Output
    //   Recovery and Serialisation"). The MPC drops a request whose bytes differ.
    outputDeserializationSchema: Bytes<LenOutputDeserialization>;

    // respondSerializationSchema is reserved for future use and IGNORED by the MPC. The
    // MPC serialises the decoded output with Borsh against a schema it derives from the
    // output types itself (see the README's "Output Recovery and Serialisation"). Leave it
    // empty: constructSignBidirectionalEventV1 pins it to Bytes<0>, and a request built by
    // hand must do the same.    
    respondSerializationSchema: Bytes<LenRespondSerialization>;
  }

  // MPCSignatureAlgorithm indicates which signature algorithm
  // will be used by the MPC to generate requested signature.
  export enum MPCSignatureAlgorithm {
    ecdsa, // ECDSA signature algorithm
    reserved, // Reserved for future use. Exists to keep enum >= 2 (proof server bug).
  }

  // MPCDestination specifies the destination field of a SignBidirectionalEvent.
  // Currently unused.
  export enum MPCDestination {
    unused,
    reserved, // Reserved for future use. Exists to keep enum >= 2 (proof server bug).
  }

  // TxParamType indicates which transaction-param decomposition a request
  // contains so an off-chain consumer (e.g. the MPC) knows how to re-assemble it.
  export enum TxParamType {
    evmType2, // EvmType2TxParams: an EIP-1559 EVM transaction (envelope + calldata)
    reserved, // Reserved for future use. Exists to keep enum >= 2 (proof server bug).
  }

  // Construction helper for the canonical Signet SignBidirectionalEventV1.
  export pure circuit constructSignBidirectionalEventV1<TxParams, #LenOutputDeserialization>(
    keyVersion: Uint<8>,
    sender: ContractAddress,
    path: Bytes<32>,
    algo: MPCSignatureAlgorithm,
    txParamType: TxParamType,
    txParams: TxParams,
    executionDest: Bytes<32>,
    signatureDest: MPCDestination,
    params: Bytes<64>,
    outputDeserializationSchema: Bytes<LenOutputDeserialization>,
  ): SignBidirectionalEventV1<TxParams, LenOutputDeserialization, 0> {
    assert(keyVersion >= 1, "keyVersion must be >= 1");
    assert(signatureDest == MPCDestination.unused, "signatureDest must be unused");
    assert(params == default<Bytes<64>>, "params must be zero");
    // The protocol reserves the "midnight response key" path for the MPC's
    // attestation key of this contract (see RespondBidirectionalEventV1), and the
    // MPC refuses a request that names it.
    assert(path != pad(32, "midnight response key"), "path is reserved for the MPC response key");

    // Shorthand struct fields bind positionally: this list follows the declaration order.
    return SignBidirectionalEventV1<TxParams, LenOutputDeserialization, 0> {
      keyVersion,
      sender,
      path,
      algo,
      txParamType,
      txParams,
      executionDest,
      signatureDest,
      params,
      outputDeserializationSchema,
      default<Bytes<0>>,
    };
  }

  // ---- SignBidirectionalEvent RequestId --------------------------------------------------------------

  // 32-byte chain-agnostic nominal id derived by calculateRequestIdV1.
  export new type RequestId = Bytes<32>;

  // The fields of a SignBidirectionalEventV1 that name one execution: the signing key
  // (keyVersion, path, algo), the requesting contract, the transaction and its execution
  // destination. Fields the execution does not depend on (the serialisation schemas and
  // the reserved MPC parameters signatureDest and params) stay out. The transaction
  // enters as a digest computed per TxParamType over its USED entries only
  // (calculateEvmType2TxParamsDigestV1 for evmType2), so one execution has one id
  // whatever capacities the requester compiled with and whatever sits in unused slots.
  //
  // KEY: the field order follows SignBidirectionalEventV1's and is relied upon for consistent
  //      hashing. The TS twin (requestIdPreimageDescriptor in signet-requests.ts) mirrors it
  //      field by field.
  export struct RequestIdPreimageV1 {
    keyVersion: Uint<8>;
    sender: ContractAddress;
    path: Bytes<32>;
    algo: MPCSignatureAlgorithm;
    txParamType: TxParamType;
    txParamsDigest: Bytes<32>;
    executionDest: Bytes<32>;
  }

  // Off-chain recomputation must prefix the preimage with HashDomain.requestId
  // and reproduce its field-aligned layout exactly. A ledger-era hash change
  // requires draining pending requests before the fork.
  export pure circuit calculateRequestIdV1(preimage: RequestIdPreimageV1): RequestId {
    return upgradeFromTransient(transientHash<[HashDomain, RequestIdPreimageV1]>([HashDomain.requestId, preimage])) as RequestId;
  }

  // ---- Client Contract: SignBidirectionalEvent Map ---------------------------------------------------

  // Named mapping of RequestId to SignBidirectionalEvent. Declared by client contracts
  // in their ledger. Client contract tells MPC field location of this map when making a cross
  // contract call, via SignetSigner, to the Signet singleton. The MPC looks here to find
  // SignBidirectionalEvents.
  export new type SignBidirectionalEventMapV1<TxParams, #LenOutputDeserialization> = Map<RequestId, SignBidirectionalEventV1<TxParams, LenOutputDeserialization, 0>>;

  // ---- Cross Contract SignBidirectionalEventNotification ---------------------------------------------

  // Contract interface used by client contract to make cross contract calls to
  // Signet singleton to notify the MPC of a SignBidirectionalEvent.
  export contract SignetSigner {
    // Called by client contracts to notify the MPC of a SignBidirectionalEvent.
    circuit signBidirectional(
      // Canonical id of the SignBidirectionalEvent (calculateEvmType2RequestIdV1 for evmType2).
      // Disclosed in the emitted notification event: the MPC looks this id up in the
      // caller's own request map.
      requestId: RequestId,
      // Versioned notification of the SignBidirectionalEvent
      // (construct with constructSignBidirectionalEventNotificationV1).
      notification: SignBidirectionalEventNotification
    ): [];
  }

  // Notification delivered by client contracts via cross contract call to Signet singleton
  // (via SignetSigner interface) to notify the MPC of a SignBidirectionalEvent.
  export struct SignBidirectionalEventNotification {
    // Notification payload layout version.
    // Current layout version: 1 (see constructSignBidirectionalEventNotificationV1)
    version: Uint<8>;
    // Payload containing serialised notification payload.
    payload: Bytes<128>;
  }

  // Construction helper for the V1 SignBidirectionalEventNotification.
  //
  // The payload is a pointer for the MPC: the contract that holds the
  // SignBidirectionalEventMapV1 (callerAddress) and the position of that map in
  // the contract's raw ledger state tree (requestsPathDepth + requestsPath).
  //
  // Read the path from your contract's compiled artifacts, never derive it by
  // hand: each field's resolved path is its "index" in
  // managed/<contract>/compiler/contract-info.json (a bare number N means path
  // [N]). Set requestsPathDepth to the number of entries and requestsPath to
  // the path zero padded to 4 entries: [1, 14] becomes depth 2 and path
  // [1, 14, 0, 0].
  export pure circuit constructSignBidirectionalEventNotificationV1(
    // Address of the client contract that stores and notifies of this SignBidirectionalEvent.
    // Set with kernel.self(). MUST match sender in associated SignBidirectionalEvent.
    callerAddress: ContractAddress,
    // Number of meaningful entries in requestsPath: 1 for a flat (15 or fewer
    // field) contract, one more per chunk level after that (max 4).
    requestsPathDepth: Uint<8>,
    // Resolved ledger-tree path of the caller's SignBidirectionalEventMapV1, from
    // its contract-info.json "index". Entries at and beyond requestsPathDepth
    // are zero.
    requestsPath: Vector<4, Uint<8>>
  ): SignBidirectionalEventNotification {
    return SignBidirectionalEventNotification {
      version: 1,
      // 128 = 32 + 1 + 4 + 91
      payload: Bytes[
        ...callerAddress.bytes,
        requestsPathDepth,
        requestsPath[0], requestsPath[1], requestsPath[2], requestsPath[3],
        ...default<Bytes<91>>
      ]
    };
  }

  // A curve point in affine coordinates, SEC1 big-endian. Field-for-field the
  // AffinePoint of the sig-net EVM and Solana signer contracts.
  export struct AffinePoint {
    x: Bytes<32>;
    y: Bytes<32>;
  }

  // recoveryId (0 or 1) recovers the signer with the supplied s. Converting
  // high-s to low-s requires replacing s with n - s and flipping recoveryId,
  // where n is the curve's group order, even when bigR is kept unchanged.
  // Point coordinates and s are stored as BIG-endian SEC1 bytes.
  export struct Signature {
    bigR: AffinePoint;
    s: Bytes<32>;
    recoveryId: Uint<8>;
  }

  // Counterpart to SignBidirectionalEvent: the MPC generated signature a request asked for.
  // Posted by the MPC through the Signet singleton for clients to extract and build a
  // signed transaction from.
  export struct SignatureRespondedEventV1 {
    // The request this signature answers. Routing data: the singleton emits it
    // unverified, and a reader proves the signature against the request's own key.
    requestId: RequestId;
    // The requested signature over the transaction the request describes.
    signature: Signature;
  }

  // RespondBidirectionalEvent: the MPC's attestation of a foreign execution, the
  // final step of the sign bidirectional flow.
  //
  //    attestationDigest = calculateSignetAttestationDigestV1(requestId, blockHeight, outputKind, serializedOutput)
  //    signature = signSECP256k1(mpcResponseKey, attestationDigest)
  //
  // mpcResponseKey is derived like request signing keys, with the path set to the
  // fixed "midnight response key" (a protocol string that enters the derivation
  // verbatim, unlike a request's hex-encoded 32 path bytes):
  //  mpcResponseKey = f(mpcRootKey[keyVersion], caip2ChainId, sender, "midnight response key")
  //
  // The output travels off chain and the digest is recomputed at verification
  // time (verifyRespondBidirectionalEventV1). The signature is the ONLY thing that
  // distinguishes a genuine post from garbage: the singleton emits every post
  // unverified.
  export struct RespondBidirectionalEventV1 {
    // The request this attestation answers. Signed into the digest: a verified
    // post settles exactly the request it names, so a client consumes this id
    // and never one taken from elsewhere.
    requestId: RequestId;
    // Height of the finalised target-chain block holding the transaction the
    // attestation describes, in the target chain's own numbering (a slot
    // on Solana). Signed into the digest.
    blockHeight: Uint<64>;
    // The MPC's verdict on the execution, signed into the digest.
    outputKind: OutputKind;
    // Byte width of the serialised output the digest commits to (0 for a failed
    // or unviable execution), so a client holding no output yet knows which
    // width to settle at.
    serializedOutputLength: Uint<64>;
    // The attestation digest the signature is over (calculateSignetAttestationDigestV1),
    // so a reader holding no output can check the signature. The verifying
    // circuit recomputes it from the output and never reads this copy.
    digest: Bytes<32>;
    // The MPC's ECDSA signature over the attestation digest.
    signature: Signature;
  }

  // OutputKind is the MPC's verdict on a request's execution, the kind half of
  // the protocol's outcome (kind, data). The block height the attestation
  // commits to is the finalised target-chain block that settled the verdict.
  export enum OutputKind {
    executed, // finalised and succeeded: the attested output is the decoded return data, Borsh-serialised by the MPC (empty when the call returns nothing)
    failed,   // finalised and reverted: the attested output is empty (Bytes<0>)
    unviable, // a finalised transaction of another request from the same account took the nonce: the attested output is empty (Bytes<0>)
  }

  // The 32-byte attestation digest of a remote execution output:
  //    attestationDigest = upgradeFromTransient(transientHash([HashDomain.attestationDigest, requestId, blockHeight, outputKind, serializedOutputLength, serializedOutput]))
  // blockHeight is the height of the finalised target-chain block holding the
  // transaction the attestation describes, in the target chain's own
  // numbering (a slot on Solana).
  // Off-chain code uses the TypeScript twin:
  //    import { calculateSignetAttestationDigest } from "@sig-net/midnight/testing";
  export pure circuit calculateSignetAttestationDigestV1<#serializedOutputLength>(
    requestId: RequestId,
    blockHeight: Uint<64>,
    outputKind: OutputKind,
    serializedOutput: Bytes<serializedOutputLength>,
  ): Bytes<32> {
    return upgradeFromTransient(transientHash<[HashDomain, RequestId, Uint<64>, OutputKind, Uint<64>, Bytes<serializedOutputLength>]>([HashDomain.attestationDigest, requestId, blockHeight, outputKind, serializedOutputLength, serializedOutput]));
  }

  // Verifies a RespondBidirectionalEvent against its execution output and MPC
  // response key: recomputes the digest over the request id, block height,
  // output kind, output length and caller's output, then verifies its signature. Client
  // contracts run this before consuming outputs, as the singleton emits
  // responses unverified. The caller supplies
  // serializedOutput at its exact unpadded width, and the event record with
  // signature.bigR.x and signature.s byte-reversed into LITTLE-endian: the
  // scalar casts below read little-endian bytes, and the wire/ledger records
  // are big-endian, so the reversal happens off-chain where it costs nothing
  // (the TS SDK's respondBidirectionalEventToCircuitInput does it). A wrong
  // byte order fails verification, never a false accept. Of the event, requestId,
  // blockHeight, outputKind, signature.bigR.x and signature.s enter verification:
  // serializedOutputLength and digest serve off-chain readers. The digest binds
  // the event's requestId, so a client MUST consume that request and no other. An s
  // that reduces to 0 mod the curve order aborts the
  // circuit rather than returning false, so sift candidate posts off chain
  // first (verifyRespondBidirectionalSignature).
  export pure circuit verifyRespondBidirectionalEventV1<#serializedOutputLength>(
    serializedOutput: Bytes<serializedOutputLength>,
    respondBidirectionalEvent: RespondBidirectionalEventV1,
    mpcResponseKey: Secp256k1Point
  ): Boolean {
    const digest = calculateSignetAttestationDigestV1<serializedOutputLength>(
      respondBidirectionalEvent.requestId,
      respondBidirectionalEvent.blockHeight,
      respondBidirectionalEvent.outputKind,
      serializedOutput,
    );

    return secp256k1EcdsaVerify(
      digest,
      Secp256k1EcdsaSignature {
        r: respondBidirectionalEvent.signature.bigR.x as Secp256k1Scalar,
        s: respondBidirectionalEvent.signature.s as Secp256k1Scalar,
      },
      mpcResponseKey
    );
  }

  // ---- EVM Type2 Transaction Parameters --------------------------------------------------------------

  // The caip2Id of every request targeting Ethereum, whichever Ethereum network the
  // MPC deployment watches (mainnet, Sepolia or a local anvil: set per deployment).
  // The MPC routes on this exact string (Chain::Ethereum in sig-net/mpc
  // signet-primitives/src/chain.rs) and rejects the request for any other value,
  // the network's own CAIP-2 id included. EvmType2TxParams.chainId is what binds
  // the signed transaction to one network. Ethereum only: another EVM chain, such as
  // BNB Smart Chain, is a separate chain to the MPC, never one of Ethereum's networks.
  export pure circuit ethereumCaip2Id(): Bytes<32> {
    return pad(32, "eip155:1");
  }

  // The EVM transaction to be signed, decomposed into typed fields
  // (EIP-1559 / type-2: https://eips.ethereum.org/EIPS/eip-1559) so the
  // requesting contract can enforce invariants field by field. The MPC
  // re-assembles and RLP-encodes off chain.
  //
  // Every variable-length part is a compile-time CAPACITY (a generic size
  // parameter the requesting contract fixes) plus a runtime count of how many
  // leading slots are real. Unused capacity sits in the ledger record but
  // reaches neither the request id (calculateEvmType2TxParamsDigestV1 walks
  // the used slots only) nor the assembled transaction. Field order is the
  // canonical EIP-1559 RLP order and the digest order: part of the wire
  // contract, each count directly before the slot it bounds.
  //
  // KEY: texual order of the fields in this structure must remain fixed as is as their order
  //      is relied upon for consistent hashing and decoding from ledger state.
  export struct EvmType2TxParams<#maxCalldataWords, #maxAccessListEntries, #maxStorageKeysPerEntry> {
    chainId: Uint<64>;               // EIP-155 chain id of the network the signed tx is valid on
    nonce: Uint<64>;                 // account nonce of the derived sender
    maxPriorityFeePerGas: Uint<128>; // wei
    maxFeePerGas: Uint<128>;         // wei
    gasLimit: Uint<64>;              // gas ceiling for the call
    to: Bytes<20>;                   // recipient (e.g. the ERC20 contract)
    value: Uint<128>;                // ETH sent with the call, in wei
    calldata: Maybe<EvmCalldata<maxCalldataWords>>; // none = plain ETH transfer ("0x" data)
    accessListEntryCount: Uint<8>;   // how many leading accessList entries are real
    accessList: Vector<maxAccessListEntries, EvmAccessListEntry<maxStorageKeysPerEntry>>;
  }

  // One EIP-2930 access-list entry (https://eips.ethereum.org/EIPS/eip-2930):
  // an address plus the storage keys the transaction pre-declares. Keys are
  // raw 32-byte values, copied verbatim into the RLP encoding.
  //
  // KEY: texual order of the fields in this structure must remain fixed as is as their order
  //      is relied upon for consistent hashing and decoding from ledger state.
  export struct EvmAccessListEntry<#maxStorageKeys> {
    address: Bytes<20>;
    storageKeyCount: Uint<8>; // how many leading storageKeys are real
    storageKeys: Vector<maxStorageKeys, Bytes<32>>;
  }

  // ABI calldata for the EVM call: 4-byte selector + 32-byte slots
  // (https://docs.soliditylang.org/en/latest/abi-spec.html).
  // CRITICAL: every ABI word here must be stored in canonical ABI form, as
  // the MPC signs a transaction composed of exactly these words. See the
  // ABI Calldata Word Construction Utilities below for help constructing
  // canonical ABI words for common types.
  //
  // KEY: texual order of the fields in this structure must remain fixed as is as their order
  //      is relied upon for consistent hashing and decoding from ledger state.
  export struct EvmCalldata<#maxWords> {
    selector: Bytes<4>;  // the literal first 4 calldata bytes
    noWords: Uint<16>;   // No. of used words in the words list
    words: Vector<maxWords, Bytes<32>>; // canonical ABI words (big-endian)
  }

  // Digest of an EvmType2TxParams over the bytes that reach the signed transaction:
  // the scalar fields, then the calldata words, access-list entries and storage keys
  // up to their declared counts, each count hashed beside its entries so the encoding
  // commits to its length. Slots past a count are skipped, and an absent calldata
  // contributes only its absence, so one transaction has one digest whatever
  // capacities the requester compiled its struct with and whatever bytes sit in
  // unused slots. The counts must fit their capacities. Off-chain code uses the
  // TypeScript twin calculateEvmType2TxParamsDigest in @sig-net/midnight.
  //
  // The slot walks are folds carrying the slot index and a running hash: a `for`
  // over `0..n` has no index type at n = 0, and a zero capacity is the common case.
  export pure circuit calculateEvmType2TxParamsDigestV1<#maxCalldataWords, #maxAccessListEntries, #maxStorageKeysPerEntry>(
    txParams: EvmType2TxParams<maxCalldataWords, maxAccessListEntries, maxStorageKeysPerEntry>
  ): Bytes<32> {
    // An absent calldata contributes is_some = false, a zero selector and a zero word count.
    const calldata = txParams.calldata;
    const noWords = calldata.is_some ? calldata.value.noWords : 0 as Uint<16>;
    const selector = calldata.is_some ? calldata.value.selector : default<Bytes<4>>;

    assert(noWords <= maxCalldataWords, "calldata noWords exceeds capacity");
    assert(txParams.accessListEntryCount <= maxAccessListEntries, "accessListEntryCount exceeds capacity");

    // For every used access-list entry, confirm its storageKeyCount fits
    // maxStorageKeysPerEntry. A Compact loop needs a compile-time bound, so the walk
    // is a fold over every slot carrying [slot index, all fit so far], and the index
    // picks out the used entries.
    const keyCountsFit = fold(
      (acc: [Uint<8>, Boolean], entry: EvmAccessListEntry<maxStorageKeysPerEntry>): [Uint<8>, Boolean] =>
        [(acc[0] + 1) as Uint<8>, acc[1] && (acc[0] >= txParams.accessListEntryCount || entry.storageKeyCount <= maxStorageKeysPerEntry)],
      [0 as Uint<8>, true],
      txParams.accessList
    );
    assert(keyCountsFit[1], "a used entry's storageKeyCount exceeds capacity");

    // The scalar fields and the counts, hashed as one field-aligned tuple.
    const head = transientHash<[HashDomain, Uint<64>, Uint<64>, Uint<128>, Uint<128>, Uint<64>, Bytes<20>, Uint<128>, Boolean, Bytes<4>, Uint<16>, Uint<8>]>([
      HashDomain.evmType2TxHeader,
      txParams.chainId,
      txParams.nonce,
      txParams.maxPriorityFeePerGas,
      txParams.maxFeePerGas,
      txParams.gasLimit,
      txParams.to,
      txParams.value,
      calldata.is_some,
      selector,
      noWords,
      txParams.accessListEntryCount
    ]);

    // The calldata words below noWords, chained onto the head one word at a time.
    // calldata.value is read whether or not the calldata is present: with noWords
    // at zero every step passes the head through.
    const wordsScan = fold(
      (acc: [Uint<16>, Field], word: Bytes<32>): [Uint<16>, Field] =>
        [(acc[0] + 1) as Uint<16>, acc[0] < noWords ? transientHash<[HashDomain, Field, Bytes<32>]>([HashDomain.evmType2TxWord, acc[1], word]) : acc[1]],
      [0 as Uint<16>, head],
      calldata.value.words
    );

    // The access-list entries below accessListEntryCount, each chained on as its
    // address, its key count and a digest of its storage keys below that count
    // (the inner fold, started from a zero Field).
    const listScan = fold(
      (acc: [Uint<8>, Field], entry: EvmAccessListEntry<maxStorageKeysPerEntry>): [Uint<8>, Field] =>
        [
          (acc[0] + 1) as Uint<8>,
          acc[0] < txParams.accessListEntryCount
            ? transientHash<[HashDomain, Field, Bytes<20>, Uint<8>, Field]>([
                HashDomain.evmType2TxAccessEntry,
                acc[1],
                entry.address,
                entry.storageKeyCount,
                fold(
                  (keyAcc: [Uint<8>, Field], key: Bytes<32>): [Uint<8>, Field] =>
                    [(keyAcc[0] + 1) as Uint<8>, keyAcc[0] < entry.storageKeyCount ? transientHash<[HashDomain, Field, Bytes<32>]>([HashDomain.evmType2TxStorageKey, keyAcc[1], key]) : keyAcc[1]],
                  [0 as Uint<8>, 0 as Field],
                  entry.storageKeys
                )[1]
              ])
            : acc[1]
        ],
      [0 as Uint<8>, wordsScan[1]],
      txParams.accessList
    );

    // The running hash is a Field. upgradeFromTransient writes it out as Bytes<32>.
    return upgradeFromTransient(listScan[1]);
  }

  // The request id of an EVM type-2 request: its preimage with the transaction digested
  // by calculateEvmType2TxParamsDigestV1. Off-chain code uses the TypeScript twin:
  //    import { calculateRequestId } from "@sig-net/midnight";
  export pure circuit calculateEvmType2RequestIdV1<#maxCalldataWords, #maxAccessListEntries, #maxStorageKeysPerEntry, #LenOutputDeserialization>(
    request: SignBidirectionalEventV1<EvmType2TxParams<maxCalldataWords, maxAccessListEntries, maxStorageKeysPerEntry>, LenOutputDeserialization, 0>
  ): RequestId {
    assert(request.txParamType == TxParamType.evmType2, "txParamType must tag txParams as evmType2");
    const preimage = RequestIdPreimageV1 {
      keyVersion: request.keyVersion,
      sender: request.sender,
      path: request.path,
      algo: request.algo,
      txParamType: request.txParamType,
      txParamsDigest: calculateEvmType2TxParamsDigestV1<maxCalldataWords, maxAccessListEntries, maxStorageKeysPerEntry>(request.txParams),
      executionDest: request.executionDest,
    };
    return calculateRequestIdV1(preimage);
  }

  // ---- ABI Calldata Word Construction Utilities ------------------------------------------------------
  // Canonical ABI word builders and readers. Words MUST be stored in canonical
  // ABI form (big-endian, per the ABI spec). These utilities help construct
  // canonical ABI words for common types.

  // Construct the canonical ABI word for a 20-byte EVM address.
  // Output format: 12 zero bytes, then the 20 display-order address bytes.
  export pure circuit evmAddressAbiWord(addr: Bytes<20>): Bytes<32> {
    return Bytes[...default<Bytes<12>>, ...addr];
  }

  // Construct the canonical ABI word for a Uint<128> value (e.g. an ERC20 amount).
  // Output format: the value as a 32-byte big-endian integer.
  export pure circuit numericAbiWord(value: Uint<128>): Bytes<32> {
    // Compact's Uint->Bytes cast is little-endian,
    // so cast to 16 LE bytes and emit them reversed into the low half.
    const le = (value as Bytes<16>) as Vector<16, Uint<8>>;
    return Bytes[
      ...default<Bytes<16>>,
      le[15], le[14], le[13], le[12], le[11], le[10], le[9], le[8],
      le[7],  le[6],  le[5],  le[4],  le[3],  le[2],  le[1], le[0]
    ];
  }

  // Construct the canonical ABI word for a Boolean.
  // Output format: 31 zero bytes, then 0x01 (true) or 0x00 (false).
  export pure circuit boolAbiWord(value: Boolean): Bytes<32> {
    return Bytes[...default<Bytes<31>>, value as Uint<8>];
  }

  // Read a numeric ABI word back into a Uint<128>: the inverse of
  // numericAbiWord. Asserts the leading 16 bytes are zero (a canonical
  // Uint<128> word). Decomposes the word into bytes exactly once (each
  // slice would redecompose the whole word) and folds v[16..31] by Horner.
  export pure circuit abiWordToUint128(word: Bytes<32>): Uint<128> {
    const v = word as Vector<32, Uint<8>>;
    assert(v[0] == 0, "ABI word exceeds Uint<128>");
    assert(v[1] == 0, "ABI word exceeds Uint<128>");
    assert(v[2] == 0, "ABI word exceeds Uint<128>");
    assert(v[3] == 0, "ABI word exceeds Uint<128>");
    assert(v[4] == 0, "ABI word exceeds Uint<128>");
    assert(v[5] == 0, "ABI word exceeds Uint<128>");
    assert(v[6] == 0, "ABI word exceeds Uint<128>");
    assert(v[7] == 0, "ABI word exceeds Uint<128>");
    assert(v[8] == 0, "ABI word exceeds Uint<128>");
    assert(v[9] == 0, "ABI word exceeds Uint<128>");
    assert(v[10] == 0, "ABI word exceeds Uint<128>");
    assert(v[11] == 0, "ABI word exceeds Uint<128>");
    assert(v[12] == 0, "ABI word exceeds Uint<128>");
    assert(v[13] == 0, "ABI word exceeds Uint<128>");
    assert(v[14] == 0, "ABI word exceeds Uint<128>");
    assert(v[15] == 0, "ABI word exceeds Uint<128>");
    const b0 = v[16] as Field;
    const b1 = b0 * 256 + (v[17] as Field);
    const b2 = b1 * 256 + (v[18] as Field);
    const b3 = b2 * 256 + (v[19] as Field);
    const b4 = b3 * 256 + (v[20] as Field);
    const b5 = b4 * 256 + (v[21] as Field);
    const b6 = b5 * 256 + (v[22] as Field);
    const b7 = b6 * 256 + (v[23] as Field);
    const b8 = b7 * 256 + (v[24] as Field);
    const b9 = b8 * 256 + (v[25] as Field);
    const b10 = b9 * 256 + (v[26] as Field);
    const b11 = b10 * 256 + (v[27] as Field);
    const b12 = b11 * 256 + (v[28] as Field);
    const b13 = b12 * 256 + (v[29] as Field);
    const b14 = b13 * 256 + (v[30] as Field);
    const b15 = b14 * 256 + (v[31] as Field);
    return b15 as Uint<128>;
  }

  // ---- Attested output readers ------------------------------------------------------------------

  // Narrow an attested uint256 (32 little-endian bytes) to Uint<128>.
  // Aborts if the value is 2^128 or more.
  export pure circuit checkedTruncationU128(x: Bytes<32>): Uint<128> {
    // This check seems pointless but is important. DO NOT REMOVE.
    const v = x as Vector<32, Uint<8>>;
    assert(v[31] == 0, "Value exceeds Uint<128>");
    return x as Uint<128>;
  }

  // Read a Boolean ABI word back into a Boolean. The first 31 bytes must be
  // zero and the last byte 0 or 1: any non-canonical word is rejected.
  export pure circuit abiWordToBool(word: Bytes<32>): Boolean {
    assert(slice<31>(word, 0) as Field == 0 as Field, "ABI word is not a canonical Boolean");
    const last = slice<1>(word, 31) as Field;
    assert(last == 0 as Field || last == 1 as Field, "ABI word is not a canonical Boolean");
    return last == 1 as Field;
  }
}
